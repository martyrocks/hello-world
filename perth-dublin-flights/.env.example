# Copy to .env and fill in whichever sources you have. With none set, the app
# runs on clearly-labelled demo data.

# Travelpayouts / Aviasales Data API (free signup at travelpayouts.com).
# Cached fares; used to scout whole months cheaply.
TRAVELPAYOUTS_TOKEN=

# Duffel (duffel.com). duffel_test_... tokens return sandbox data,
# live tokens return real airline offers.
DUFFEL_ACCESS_TOKEN=

# SerpApi Google Flights engine (serpapi.com). Live Google Flights results
# plus Google's "typical price" range for the route.
SERPAPI_KEY=

# Where price history is stored (default ~/.flightfinder/history.db)
# FLIGHTFINDER_DB=

# --- Alerts (used by `watch`) ---
# Slack / Discord / any JSON webhook
ALERT_WEBHOOK_URL=
# Email via SMTP (STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- "Best value" sort tuning ---
# How much an hour of travel time is worth to you, and the cost of each extra stop
VALUE_OF_TIME=25
STOP_PENALTY=60
